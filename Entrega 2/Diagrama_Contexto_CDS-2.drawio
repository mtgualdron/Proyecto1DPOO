<mxfile host="app.diagrams.net"><diagram name="Contexto" id="ctx1"><mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Diagrama de contexto – Sistema CDS" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="520" height="30" as="geometry"/></mxCell><mxCell id="socio" value="Socio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="150" height="60" as="geometry"/></mxCell><mxCell id="entre" value="Entrenador" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="90" width="150" height="60" as="geometry"/></mxCell><mxCell id="fisio" value="Fisioterapeuta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="400" width="150" height="60" as="geometry"/></mxCell><mxCell id="admin" value="Administrador" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="150" height="60" as="geometry"/></mxCell><mxCell id="sys" value='&lt;b&gt;Sistema CDS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Lógica del club (equipos, partidos, competencias, reservas, entrenamientos, turnos, ventas y reportes).&lt;br&gt;Sin interfaz: se demuestra con consolas de prueba.&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="300" height="170" as="geometry"/></mxCell><mxCell id="datos" value='Carpeta de datos&lt;br&gt;&lt;font style="font-size:11px"&gt;archivos de texto, fuera de la carpeta del código&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="260" height="110" as="geometry"/></mxCell><mxCell id="e1" value="Inscribirse, reservar, comprar,&#10;consultar estado y estadísticas" style="endArrow=open;startArrow=open;endFill=0;startFill=0;html=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="socio" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Programar sesiones, registrar asistencia,&#10;evaluaciones y tarjetas; solicitar turno" style="endArrow=open;startArrow=open;endFill=0;startFill=0;html=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="entre" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Registrar evaluación física y aptitud;&#10;consultar historial; solicitar turno" style="endArrow=open;startArrow=open;endFill=0;startFill=0;html=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fisio" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Crear y dar de baja equipos y jugadores,&#10;aprobar turnos y sugerencias,&#10;reabastecer y pedir reportes" style="endArrow=open;startArrow=open;endFill=0;startFill=0;html=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Guardar y cargar el estado" style="endArrow=open;startArrow=open;endFill=0;startFill=0;html=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;startArrow=open;" edge="1" parent="1" source="sys" target="datos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="&lt;b&gt;Fuera del sistema&lt;/b&gt;: pagos reales, interfaz gráfica, sistemas de ASCUN o del Torneo de los Cerros (los resultados se registran a mano) y cualquier otro sistema externo." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#fff9c4;strokeColor=#bfae30;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="280" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>